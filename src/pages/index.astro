---
import Layout from '../layouts/Layout.astro';
import { loadRegistry } from '../data/registry';
import { toRows, counts } from '../lib/to-rows.js';

const registry = await loadRegistry();
const rows = [
  ...toRows(registry.official, 'official'),
  ...toRows(registry.community, 'community'),
  ...toRows(registry.templates, 'template'),
];
const n = counts(registry);
const kinds = [
  { v: 'all', label: 'All', n: n.all },
  { v: 'official', label: 'Official', n: n.official },
  { v: 'community', label: 'Community', n: n.community },
  { v: 'template', label: 'Template', n: n.template },
];
---

<Layout title="Registry">
  <div class="u-wrap u-reg">
    <h1>Registry</h1>
    <p class="u-lede">Every tool ucli can install, with the commit it is pinned to, and the starter templates.</p>

    <div class="u-search" id="search" hidden>
      <label for="q">Search tools</label>
      <div class="u-search__f">
        <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="2"/><path d="M15.5 15.5 21 21" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        <input type="search" id="q" placeholder="Name or what it does" autocomplete="off" />
      </div>
    </div>

    <div class="u-bar">
      <div class="u-filters" id="filters" hidden>
        <div class="u-fgroup" role="group" aria-labelledby="f-kind">
          <span class="u-fgroup__l" id="f-kind">Kind</span>
          <div class="u-fgroup__b">
            {kinds.map((k) => (
              <button type="button" data-v={k.v} aria-pressed={k.v === 'all' ? 'true' : 'false'}>{k.label} <span class="u-count-n">{k.n}</span></button>
            ))}
          </div>
        </div>
      </div>
      <p class="u-total" role="status">Showing <b id="shown">{n.all}</b> of {n.all} tools</p>
    </div>

    <table class="u-table">
      <caption class="u-visually-hidden">ucli registry</caption>
      <thead>
        <tr><th scope="col">Tool</th><th scope="col">Pinned commit</th><th scope="col">Kind</th><th scope="col">Description</th></tr>
      </thead>
      <tbody>
        {rows.map((r) => (
          <tr data-kind={r.kind}>
            <td class="u-tn">{r.href ? <a href={r.href} rel="noopener noreferrer">{r.name}</a> : r.name}</td>
            <td class={r.kind === 'template' ? 'u-tc u-tc-t' : 'u-tc'}><code title={r.shaTitle}>{r.short}</code></td>
            <td class="u-tk">{r.kindLabel}</td>
            <td class="u-td">{r.description}</td>
          </tr>
        ))}
        <tr class="u-empty" id="empty" hidden>
          <td colspan="4"><b>No tools match.</b> Clear the search or pick another filter.{n.community === 0 && ' No community tools are listed yet.'}</td>
        </tr>
      </tbody>
    </table>

    <p class="u-more">Each tool's pin is the exact commit ucli builds; templates are not installed by ucli. Pins change by pull request, after checks on the new commit. Most tools have no tests of their own yet; this list does not yet say which. Pins as of {registry.builtOn} (UTC).</p>
  </div>
</Layout>

<script is:inline>
(function () {
  var q = document.getElementById('q');
  var rows = [].slice.call(document.querySelectorAll('.u-table tbody tr[data-kind]'));
  var empty = document.getElementById('empty');
  var shown = document.getElementById('shown');
  var buttons = [].slice.call(document.querySelectorAll('.u-fgroup__b button'));
  var kind = 'all';
  function run() {
    var term = (q.value || '').trim().toLowerCase(), count = 0;
    rows.forEach(function (r) {
      var ok = (kind === 'all' || r.getAttribute('data-kind') === kind) && (!term || r.querySelector('.u-tn').textContent.toLowerCase().indexOf(term) >= 0 || r.querySelector('.u-td').textContent.toLowerCase().indexOf(term) >= 0);
      r.hidden = !ok;
      if (ok) count++;
    });
    empty.hidden = count > 0;
    shown.textContent = count;
  }
  q.addEventListener('input', run);
  document.getElementById('search').hidden = false;
  document.getElementById('filters').hidden = false;
  buttons.forEach(function (b) {
    b.addEventListener('click', function () {
      kind = b.getAttribute('data-v');
      buttons.forEach(function (o) { o.setAttribute('aria-pressed', String(o === b)); });
      run();
    });
  });
  run();
})();
</script>
